{
	"name": "bookdog",
	"description": "Booking.com availability watchdog — scrapes properties, alerts via Slack",
	"version": "1.1.2",
	"license": "PolyForm-Noncommercial-1.0.0",
	"packageManager": "pnpm@12.16.1",
	"scripts": {
		"changeset": "node scripts/changeset.mjs",
		"check": "node src/check.mjs",
		"check.dry": "node --env-file=.env src/check.mjs",
		"lint.check": "biome check",
		"lint.write": "biome check --write",
		"test": "node --test tests/*.test.mjs",
		"test.alert": "node --env-file=.env tests/send-test-alert.mjs"
	},
	"dependencies": {
		"googleapis": "171.4.0",
		"playwright": "1.64.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@clack/prompts": "1.8.1"
	},
	"engines": {
		"node": "26.13.0"
	}
}
